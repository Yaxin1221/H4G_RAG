# ---- Infomaniak AI Tools (Swiss-hosted, OpenAI-compatible) ----
# Required. Create a token at https://manager.infomaniak.com (API tokens, scope "ai-tools").
INFOMANIAK_API_KEY=
# Required. GET https://api.infomaniak.com/1/ai with the token to find it.
INFOMANIAK_PRODUCT_ID=
# Optional model override (default google/gemma-4-31B-it).
# GET .../2/ai/<product_id>/openai/v1/models lists what is available.
# INFOMANIAK_MODEL=google/gemma-4-31B-it

# ---- WordPress source ----
WP_BASE_URL=https://rightsinexile.org

# Optional. The public REST API serves all *published* pages without auth,
# which is everything this bot needs -- leave these blank unless you also
# want drafts/private pages.
#
# NOTE: your wp-admin login password will NOT work here. WordPress REST
# basic auth requires an Application Password:
#   wp-admin -> Users -> Profile -> Application Passwords -> add new
WP_USER=
WP_APP_PASSWORD=

# ---- Server ----
# Max requests per IP per hour on /api/chat. A public chatbot is an open wallet.
RATE_LIMIT_PER_HOUR=30
